{
  "functions": {
    "api/chat.js":   { "maxDuration": 30 },
    "api/stream.js": { "maxDuration": 30 },
    "api/tts.js":    { "maxDuration": 30 },
    "api/share.js":  { "maxDuration": 30 },
    "api/search.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/chat",    "destination": "/api/chat.js" },
    { "source": "/api/stream",  "destination": "/api/stream.js" },
    { "source": "/api/share",   "destination": "/api/share.js" },
    { "source": "/api/tts",     "destination": "/api/tts.js" },
    { "source": "/api/search",  "destination": "/api/search.js" },
    { "source": "/index",       "destination": "/index.html" },
    { "source": "/",            "destination": "/index.html" },
    { "source": "/(.*)",        "destination": "/index.html" }
  ]
}
